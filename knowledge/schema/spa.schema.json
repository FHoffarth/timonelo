{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timonelo.com/schema/spa.schema.json",
  "title": "SpaAndWellnessSchema",
  "description": "Canonical schema for ship spa complexes, thermal suites, therapy treatment rooms, and salons.",
  "type": "object",
  "required": [
    "vessel_id",
    "provenance",
    "spa_and_wellness"
  ],
  "properties": {
    "vessel_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_artifact"
      ],
      "properties": {
        "source_artifact": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "verification_authority": {
          "type": "string"
        },
        "last_audited": {
          "type": "string"
        }
      }
    },
    "spa_and_wellness": {
      "type": "object",
      "required": [
        "id",
        "name",
        "deck",
        "category",
        "description",
        "source",
        "provenance",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "deck": {
          "type": "integer"
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "metrics": {
          "type": "object"
        },
        "source": {
          "type": "string"
        },
        "provenance": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sub_venues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "deck",
              "category",
              "description",
              "source",
              "provenance",
              "tags"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "deck": {
                "type": "integer"
              },
              "category": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "facilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "therapies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "brand_partner": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "provenance": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
