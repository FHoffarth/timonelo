{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timonelo.com/schema/spa.schema.json",
  "title": "SpaAndWellnessSchema",
  "description": "Canonical schema for ship spa complexes, thermal suites, therapy treatment rooms, and salons.",
  "type": "object",
  "required": [
    "vessel_id",
    "provenance",
    "spa_and_wellness"
  ],
  "properties": {
    "vessel_id": {
      "type": "string",
      "pattern": "\\S",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_artifact"
      ],
      "properties": {
        "source_artifact": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "verification_authority": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "last_audited": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "confidence": false,
        "confidence_score": false
      }
    },
    "spa_and_wellness": {
      "type": "object",
      "required": [
        "id",
        "source",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "deck": {
          "type": "integer"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "metrics": {
          "type": "object"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "sub_venues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "source",
              "provenance"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "deck": {
                "type": "integer"
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "facilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "therapies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "brand_partner": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "provenance": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "confidence": false,
              "confidence_score": false
            }
          }
        },
        "confidence": false,
        "confidence_score": false
      }
    }
  }
}
