{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timonelo.com/schema/route.schema.json",
  "title": "RelationalRouteSchema",
  "description": "Canonical relational schema for cruise routes, interporting legs, waypoint references, and nautical metrics.",
  "type": "object",
  "required": [
    "route_id",
    "vessel_name",
    "itinerary_type",
    "legs",
    "provenance",
    "sources"
  ],
  "properties": {
    "route_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "vessel_name": {
      "type": "string"
    },
    "itinerary_type": {
      "type": "string"
    },
    "duration_nights": {
      "type": "integer",
      "minimum": 1
    },
    "total_nautical_miles_approx": {
      "type": "number"
    },
    "legs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "leg_sequence",
          "day",
          "origin_canonical_id",
          "destination_canonical_id",
          "sea_day",
          "homeport"
        ],
        "properties": {
          "leg_sequence": {
            "type": "integer",
            "minimum": 1
          },
          "day": {
            "type": "integer",
            "minimum": 1
          },
          "origin_canonical_id": {
            "type": "string"
          },
          "destination_canonical_id": {
            "type": "string"
          },
          "arrival": {
            "type": [
              "string",
              "null"
            ]
          },
          "departure": {
            "type": [
              "string",
              "null"
            ]
          },
          "sea_day": {
            "type": "boolean"
          },
          "homeport": {
            "type": "boolean"
          },
          "distance_if_known_nm": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_artifact"
      ],
      "properties": {
        "source_artifact": {
          "type": "string"
        },
        "validation_status": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "verification_authority": {
          "type": "string"
        },
        "last_audited": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
