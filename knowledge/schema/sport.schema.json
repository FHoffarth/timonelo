{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timonelo.com/schema/sport.schema.json",
  "title": "SportsAndRecreationSchema",
  "description": "Canonical schema for ship sport arenas, gyms, adventure ropes courses, and arcade simulators.",
  "type": "object",
  "required": [
    "vessel_id",
    "provenance",
    "sports_and_recreation"
  ],
  "properties": {
    "vessel_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_artifact"
      ],
      "properties": {
        "source_artifact": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "verification_authority": {
          "type": "string"
        },
        "last_audited": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sports_and_recreation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "deck",
          "category",
          "description",
          "source",
          "provenance",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "deck": {
            "type": "integer"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "activities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "brand_partner": {
            "type": "string"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": true
          },
          "sub_attractions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "deck",
                "description",
                "source",
                "provenance",
                "tags"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "deck": {
                  "type": "integer"
                },
                "description": {
                  "type": "string"
                },
                "units_count": {
                  "type": "integer"
                },
                "lanes_count": {
                  "type": "integer"
                },
                "source": {
                  "type": "string"
                },
                "provenance": {
                  "type": "string"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "source": {
            "type": "string"
          },
          "provenance": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
