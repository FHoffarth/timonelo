{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timonelo.com/schema/sport.schema.json",
  "title": "SportsAndRecreationSchema",
  "description": "Canonical schema for ship sport arenas, gyms, adventure ropes courses, and arcade simulators.",
  "type": "object",
  "required": [
    "vessel_id",
    "provenance",
    "sports_and_recreation"
  ],
  "properties": {
    "vessel_id": {
      "type": "string",
      "pattern": "\\S",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_artifact"
      ],
      "properties": {
        "source_artifact": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "verification_authority": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "last_audited": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "confidence": false,
        "confidence_score": false
      }
    },
    "sports_and_recreation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "deck": {
            "type": "integer"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "activities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "brand_partner": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "metrics": {
            "type": "object"
          },
          "sub_attractions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "source",
                "provenance"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "deck": {
                  "type": "integer"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "units_count": {
                  "type": "integer"
                },
                "lanes_count": {
                  "type": "integer"
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "provenance": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "confidence": false,
                "confidence_score": false
              }
            }
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "provenance": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "confidence": false,
          "confidence_score": false
        }
      }
    }
  }
}
