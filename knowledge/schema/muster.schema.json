{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timonelo.com/schema/muster.schema.json",
  "title": "MusterAndSafetySchema",
  "description": "Canonical schema for ship safety protocols, digital e-muster drills, and physical assembly stations.",
  "type": "object",
  "required": [
    "vessel_id",
    "provenance",
    "emergency_and_muster_protocol"
  ],
  "properties": {
    "vessel_id": {
      "type": "string",
      "pattern": "\\S",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_artifact"
      ],
      "properties": {
        "source_artifact": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "verification_authority": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "last_audited": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "confidence": false,
        "confidence_score": false
      }
    },
    "emergency_and_muster_protocol": {
      "type": "object",
      "properties": {
        "drill_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "procedure": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "wayfinding_and_egress": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "physical_muster_stations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "source",
              "provenance"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "deck": {
                "type": "integer"
              },
              "location": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "provenance": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "confidence": false,
              "confidence_score": false
            }
          }
        }
      }
    }
  }
}
