{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timonelo.com/schema/venue.schema.json",
  "title": "PublicAreasAndVenuesSchema",
  "description": "Canonical schema for ship public areas, architectural landmarks, and social spaces.",
  "type": "object",
  "required": [
    "vessel_id",
    "provenance",
    "public_areas"
  ],
  "properties": {
    "vessel_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_artifact"
      ],
      "properties": {
        "source_artifact": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "verification_authority": {
          "type": "string"
        },
        "last_audited": {
          "type": "string"
        }
      }
    },
    "public_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "deck",
          "category",
          "description",
          "source",
          "provenance",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "deck": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "metrics": {
            "type": "object"
          },
          "source": {
            "type": "string"
          },
          "provenance": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
