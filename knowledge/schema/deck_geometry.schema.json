{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timonelo.com/schema/deck_geometry.schema.json",
  "title": "DeckGeometrySchema",
  "description": "Canonical schema for ship spatial geometry extracted from official deck plans with strict provenance.",
  "type": "object",
  "required": [
    "vessel_id",
    "deck_number",
    "deck_name",
    "provenance",
    "bounding_box",
    "objects"
  ],
  "properties": {
    "vessel_id": {
      "type": "string"
    },
    "deck_number": {
      "type": "integer"
    },
    "deck_name": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_artifact",
        "evidence_page",
        "extracted_at"
      ],
      "properties": {
        "source_artifact": {
          "type": "string"
        },
        "evidence_page": {
          "type": "integer"
        },
        "extracted_at": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "verification_authority": {
          "type": "string"
        },
        "last_audited": {
          "type": "string"
        },
        "confidence": false,
        "confidence_score": false
      }
    },
    "bounding_box": {
      "type": "object",
      "required": [
        "min_x",
        "min_y",
        "max_x",
        "max_y",
        "width",
        "height"
      ],
      "properties": {
        "min_x": {
          "type": "number"
        },
        "min_y": {
          "type": "number"
        },
        "max_x": {
          "type": "number"
        },
        "max_y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "polygon",
          "centroid",
          "door_position",
          "orientation",
          "bounding_box",
          "adjacent_objects",
          "provenance_breakdown"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "CABIN",
              "VENUE",
              "LIFT",
              "CORRIDOR",
              "STAIRS",
              "SERVICE"
            ]
          },
          "label": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "PORT",
              "STARBOARD",
              "CENTER"
            ]
          },
          "polygon": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 3
          },
          "centroid": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "door_position": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "orientation": {
            "type": "string",
            "enum": [
              "PORT",
              "STARBOARD",
              "FORE",
              "AFT",
              "CENTER"
            ]
          },
          "bounding_box": {
            "type": "object",
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            }
          },
          "adjacent_objects": {
            "type": "object",
            "properties": {
              "fore": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "aft": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "across": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "corridor": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "nearest_lift": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "provenance_breakdown": {
            "type": "object",
            "required": [
              "polygon",
              "centroid",
              "bounding_box",
              "orientation",
              "door_position",
              "adjacent_objects"
            ],
            "properties": {
              "polygon": {
                "type": "string",
                "enum": [
                  "DIRECT",
                  "DERIVED",
                  "UNKNOWN"
                ]
              },
              "centroid": {
                "type": "string",
                "enum": [
                  "DIRECT",
                  "DERIVED",
                  "UNKNOWN"
                ]
              },
              "bounding_box": {
                "type": "string",
                "enum": [
                  "DIRECT",
                  "DERIVED",
                  "UNKNOWN"
                ]
              },
              "orientation": {
                "type": "string",
                "enum": [
                  "DIRECT",
                  "DERIVED",
                  "UNKNOWN"
                ]
              },
              "door_position": {
                "type": "string",
                "enum": [
                  "DIRECT",
                  "DERIVED",
                  "UNKNOWN"
                ]
              },
              "adjacent_objects": {
                "type": "string",
                "enum": [
                  "DIRECT",
                  "DERIVED",
                  "UNKNOWN"
                ]
              }
            }
          }
        }
      }
    }
  }
}
