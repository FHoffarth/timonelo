{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timonelo.com/schema/deck.schema.json",
  "title": "DeckInventorySchema",
  "description": "Canonical schema for ship deck inventories, categories, and accessible boundaries.",
  "type": "object",
  "required": [
    "vessel_id",
    "provenance",
    "decks"
  ],
  "properties": {
    "vessel_id": {
      "type": "string",
      "pattern": "\\S",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_artifact"
      ],
      "properties": {
        "source_artifact": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "verification_authority": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "last_audited": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "confidence": false,
        "confidence_score": false
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "decks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "deck_number",
          "source",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "deck_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "category": {
            "type": "string",
            "enum": [
              "OPERATIONAL_AND_MEDICAL",
              "PUBLIC_AND_ENTERTAINMENT",
              "PROMENADE_AND_DINING",
              "PROMENADE_AND_SPECIALTY",
              "STATEROOM_DECK",
              "STATEROOM_AND_BRIDGE",
              "LIDO_AND_BUFFET",
              "FITNESS_AND_RECREATION",
              "YOUTH_AND_ENTERTAINMENT",
              "AQUAPARK_AND_SOLARIUM",
              "OTHER"
            ],
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "passenger_accessible": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "provenance": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "confidence": false,
          "confidence_score": false
        }
      }
    }
  }
}
