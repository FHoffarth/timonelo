{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timonelo.com/schema/deck.schema.json",
  "title": "DeckInventorySchema",
  "description": "Canonical schema for ship deck inventories, categories, and accessible boundaries.",
  "type": "object",
  "required": [
    "vessel_id",
    "provenance",
    "decks"
  ],
  "properties": {
    "vessel_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_artifact"
      ],
      "properties": {
        "source_artifact": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "verification_authority": {
          "type": "string"
        },
        "last_audited": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "decks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "deck_number",
          "category",
          "description",
          "passenger_accessible",
          "source",
          "provenance",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "deck_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "category": {
            "type": "string",
            "enum": [
              "OPERATIONAL_AND_MEDICAL",
              "PUBLIC_AND_ENTERTAINMENT",
              "PROMENADE_AND_DINING",
              "PROMENADE_AND_SPECIALTY",
              "STATEROOM_DECK",
              "STATEROOM_AND_BRIDGE",
              "LIDO_AND_BUFFET",
              "FITNESS_AND_RECREATION",
              "YOUTH_AND_ENTERTAINMENT",
              "AQUAPARK_AND_SOLARIUM",
              "OTHER"
            ]
          },
          "description": {
            "type": "string"
          },
          "passenger_accessible": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          },
          "provenance": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
