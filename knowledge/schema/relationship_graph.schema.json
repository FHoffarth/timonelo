{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timonelo.com/schema/relationship_graph.schema.json",
  "title": "KnowledgeRelationshipGraphSchema",
  "description": "Canonical schema for relational cross-references between ships, routes, ports, and terminals.",
  "type": "object",
  "required": [
    "provenance",
    "ships_to_routes",
    "routes_to_ports",
    "ports_to_terminals",
    "port_slug_to_unlocode"
  ],
  "properties": {
    "provenance": {
      "type": "object",
      "required": [
        "source_artifact"
      ],
      "properties": {
        "source_artifact": {
          "type": "string"
        },
        "confidence": false,
        "confidence_score": false
      }
    },
    "ships_to_routes": {
      "type": "object"
    },
    "routes_to_ports": {
      "type": "object"
    },
    "ports_to_terminals": {
      "type": "object"
    },
    "port_slug_to_unlocode": {
      "type": "object"
    }
  }
}
