{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timonelo.com/schema/cabin.schema.json",
  "title": "CabinCategoriesSchema",
  "description": "Canonical schema for ship staterooms, suites, and bespoke signature suites.",
  "type": "object",
  "required": [
    "vessel_id",
    "provenance",
    "cabin_categories"
  ],
  "properties": {
    "vessel_id": {
      "type": "string",
      "pattern": "\\S",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_artifact"
      ],
      "properties": {
        "source_artifact": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "verification_authority": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "last_audited": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "confidence": false,
        "confidence_score": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_staterooms": {
          "type": "integer"
        },
        "distinct_categories_count": {
          "type": "integer"
        },
        "balcony_percentage": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 100.0
        },
        "standard_amenities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "cabin_categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "deck": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer"
                }
              }
            ]
          },
          "cabin_number": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "position": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "metrics": {
            "type": "object"
          },
          "perks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "design_partners": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "provenance": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "confidence": false,
          "confidence_score": false
        }
      }
    }
  }
}
