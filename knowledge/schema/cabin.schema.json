{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timonelo.com/schema/cabin.schema.json",
  "title": "CabinCategoriesSchema",
  "description": "Canonical schema for ship staterooms, suites, and bespoke signature suites.",
  "type": "object",
  "required": ["vessel_id", "provenance", "summary", "cabin_categories"],
  "properties": {
    "vessel_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "provenance": {
      "type": "object",
      "required": ["source_artifact", "confidence"],
      "properties": {
        "source_artifact": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_staterooms", "distinct_categories_count", "balcony_percentage", "standard_amenities"],
      "properties": {
        "total_staterooms": { "type": "integer" },
        "distinct_categories_count": { "type": "integer" },
        "balcony_percentage": { "type": "number" },
        "standard_amenities": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "cabin_categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "deck",
          "description",
          "source",
          "provenance",
          "confidence",
          "tags"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "deck": {
            "oneOf": [
              { "type": "integer" },
              { "type": "array", "items": { "type": "integer" } }
            ]
          },
          "cabin_number": { "type": "string" },
          "position": { "type": "string" },
          "description": { "type": "string" },
          "metrics": {
            "type": "object",
            "additionalProperties": true
          },
          "perks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "features": {
            "type": "array",
            "items": { "type": "string" }
          },
          "design_partners": {
            "type": "array",
            "items": { "type": "string" }
          },
          "source": { "type": "string" },
          "provenance": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
