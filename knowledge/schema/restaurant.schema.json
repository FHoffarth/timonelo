{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timonelo.com/schema/restaurant.schema.json",
  "title": "RestaurantsSchema",
  "description": "Canonical schema for ship restaurants, dining rooms, buffets, and specialty culinary venues.",
  "type": "object",
  "required": [
    "vessel_id",
    "provenance",
    "restaurants"
  ],
  "properties": {
    "vessel_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_artifact"
      ],
      "properties": {
        "source_artifact": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "verification_authority": {
          "type": "string"
        },
        "last_audited": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "restaurants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "deck",
          "category",
          "description",
          "dining_model",
          "source",
          "provenance",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "deck": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "MAIN_DINING_ROOM",
              "CASUAL_BUFFET",
              "SPECIALTY_STEAKHOUSE",
              "SPECIALTY_ASIAN",
              "SPECIALTY_SUSHI",
              "SPECIALTY_LATIN",
              "SPECIALTY_FRENCH",
              "SPECIALTY_ITALIAN",
              "EXCLUSIVE_GOURMET",
              "EXCLUSIVE_OUTDOOR_GRILL",
              "OTHER_DINING"
            ]
          },
          "description": {
            "type": "string"
          },
          "dining_model": {
            "type": "string"
          },
          "cuisine_type": {
            "type": "string"
          },
          "seating_capacity": {
            "type": "integer"
          },
          "source": {
            "type": "string"
          },
          "provenance": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
