{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timonelo.com/schema/restaurant.schema.json",
  "title": "RestaurantsSchema",
  "description": "Canonical schema for ship restaurants, dining rooms, buffets, and specialty culinary venues.",
  "type": "object",
  "required": [
    "vessel_id",
    "provenance",
    "restaurants"
  ],
  "properties": {
    "vessel_id": {
      "type": "string",
      "pattern": "\\S",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_artifact"
      ],
      "properties": {
        "source_artifact": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "verification_authority": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "last_audited": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "confidence": false,
        "confidence_score": false
      }
    },
    "restaurants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "deck": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 1
              }
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "MAIN_DINING_ROOM",
              "CASUAL_BUFFET",
              "SPECIALTY_STEAKHOUSE",
              "SPECIALTY_ASIAN",
              "SPECIALTY_SUSHI",
              "SPECIALTY_LATIN",
              "SPECIALTY_FRENCH",
              "SPECIALTY_ITALIAN",
              "EXCLUSIVE_GOURMET",
              "EXCLUSIVE_OUTDOOR_GRILL",
              "OTHER_DINING"
            ],
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "dining_model": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "cuisine_type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "seating_capacity": {
            "type": "integer"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "provenance": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "confidence": false,
          "confidence_score": false
        }
      }
    }
  }
}
