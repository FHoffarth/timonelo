# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.coverage.*

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
dist/

# Environments and local configuration
.venv/
venv/
ENV/
.env
.env.*
!.env.example

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Local or generated data
data/source/*
!data/source/.gitignore
data/processed/*
!data/processed/.gitignore

# Test / Scratch artifacts
scratch/*.png
scratch/*.jpg
scratch/*.log
*.log

# Local / Private evidence outside git tracking
.local/
.private/
